#!/usr/bin/env zsh
# bin/phaverlite-lsp — launch the phaverlite LSP server from a pre-dumped
# SBCL image. Spawned by lem-lsp-mode when a .pha buffer opens.
#
# By using `sbcl --core var/lsp.core` directly (no qlot, no roswell wrapper),
# we eliminate the env-coupling failure class that breaks qlot when lem's
# subprocess inherits CL_SOURCE_REGISTRY / XDG_* etc. The core has
# phaverlite-lsp pre-loaded; its toplevel calls (phaverlite-lsp/main:run)
# which speaks JSON-RPC on stdio.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$SCRIPT_DIR/.." && pwd)"

if ! command -v sbcl >/dev/null 2>&1; then
  print -u2 "phaverlite-lsp: 'sbcl' not found on PATH."
  exit 1
fi
if [[ ! -f "$REPO/var/lsp.core" ]]; then
  print -u2 "phaverlite-lsp: $REPO/var/lsp.core missing. Run 'bin/build-image' first."
  exit 1
fi

cd "$REPO"
mkdir -p "$REPO/var/log"
# Send stderr to a file so SBCL crash messages aren't swallowed by lem.
exec sbcl \
  --noinform \
  --core "$REPO/var/lsp.core" \
  --no-userinit \
  --no-sysinit \
  2>>"$REPO/var/log/lsp-stderr.log"
