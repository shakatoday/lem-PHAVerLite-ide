# Coursework / personal reference material — local only, never publish.
# These directories may contain peer names, prior solutions, or distributed
# materials that should not be on a public repo.
Lab3/
ps3/

# qlot per-project install dir — reproducible from qlfile.lock, no need to commit.
.qlot/
.bundle-libs/

# Local Claude Code session state — per-machine, never published.
.claude/

# Developer-local clone of lem source (optional, for browsing/patching).
# qlot manages the canonical copy under .qlot/; this is just scratch.
# Dotted name keeps qlot's project-root scan from picking up its asd files
# and conflicting with the qlot-pinned lem (manifests as "FUNDAMENTAL-MODE
# already defined" debugger drop on bin/test-mode).
/.lem-ref/

# Compiled Lisp artifacts.
*.fasl
*.fasl.gz
*.lx32fsl
*.lx64fsl
*.dx32fsl
*.dx64fsl
*.dfsl
*.pfsl
*.d64fsl
*.p64fsl

# Editor / OS junk.
.DS_Store
*.swp
*.swo
*~
\#*\#
.\#*

# Local environment / secrets — defense in depth, even though we don't expect any.
.env
.env.*
*.pem
*.key
secrets/
.secrets/

# Project-specific sensitive token patterns for bin/privacy-preflight.
# Real names, classmate emails, personal handles — never committed.
.privacy-patterns

# Local PHAVerLite / plotutils run outputs (reproducible from the .pha source).
/tmp_runs/
*.out.tmp
out_reach
out_inv
out_invar
out_reachable
out_init

# Vendored dependencies are NOT ignored by default — if we deliberately fork
# lem (or anything else) into vendor/, it should be committed. Add specific
# subpaths here only when needed.

# Runtime state for the launcher (LEM_HOME, XDG_* dirs).
# Reproducible per launch; never committed.
var/*
!var/.gitkeep
